(() => {
  'use strict';
  const lessons = [
    {id:'help-route',title:'Как попросить о помощи и быть услышанным',topic:'Маршрут помощи',ages:['6–10 лет','11–14 лет','15–18 лет'],goal:'Участники узнают, как обратиться к безопасному взрослому, сообщить факты и продолжать искать помощь, если первый взрослый не отреагировал.',materials:'Карточки ситуаций, лист бумаги, доска.',steps:[['Начало и безопасность',5,'Скажи: мы обсуждаем вымышленные примеры, не называем имён и не просим рассказывать личные истории. Можно пропустить любой ответ.'],['Что значит обратиться за помощью',7,'Объясни: просить помощи — нормальный и ответственный шаг. Важно сообщить взрослому, что произошло, где и какая поддержка нужна.'],['Разбор ситуации',10,'Прочитайте карточку №1. Предложите несколько безопасных вариантов действий. Не оценивайте ребёнка, который растерялся или не смог сразу обратиться.'],['Репетиция фразы',10,'В малых группах потренируйте нейтральную фразу: «Мне нужно сообщить о ситуации. Происходит ___. Я беспокоюсь за безопасность. Помогите, пожалуйста, разобраться».'],['Если не услышали',5,'Обсуди следующий шаг: обратиться к другому ответственному взрослому, классному руководителю, школьному психологу, администрации или родителю.'],['Завершение',3,'Попроси назвать один возможный канал помощи. Не требуй публичных обещаний.']],cards:[['Ситуация 1. Нужна помощь','Ученик замечает, что одноклассника регулярно унижают в общем чате. Он хочет сообщить взрослому, но боится, что станет хуже.','Какие факты можно сообщить? Кому? Как не распространять унизительные сообщения дальше?'],['Ситуация 2. Не услышали','Ученик рассказал взрослому о происходящем, но услышал: «Не обращай внимания». Ситуация продолжается.','К кому ещё можно обратиться? Как повторно сообщить о продолжающейся опасности?'],['Ситуация 3. Срочная опасность','Во время перемены возникла угроза физической расправы. Рядом есть дежурный педагог.','Как быстро привлечь взрослого? Почему нельзя вмешиваться в опасную драку в одиночку?']],exercise:'Составьте короткое обращение по схеме: что произошло — где/когда — кому может быть нужна защита — какая помощь нужна сейчас.',teacher:'Если ребёнок сообщает о реальном эпизоде, поблагодари за доверие, уточни непосредственную безопасность и действуй по школьному алгоритму. Не обещай абсолютную тайну и не устраивай публичный разбор.'},
    {id:'witness',title:'Свидетель: как помочь и не усилить травлю',topic:'Поддержка свидетеля',ages:['6–10 лет','11–14 лет','15–18 лет'],goal:'Участники различают безопасные способы поддержки и действия, которые могут усилить вред.',materials:'Карточки ситуаций, листы «безопасно / рискованно».',steps:[['Правила разговора',5,'Не разыгрываем травлю и не назначаем роли «обидчика» и «жертвы». Рассматриваем только вымышленные ситуации.'],['Кто такой свидетель',6,'Свидетель — тот, кто видит или узнаёт о происходящем. Он не обязан рисковать собой, чтобы помочь.'],['Сортировка действий',10,'Разложи варианты: поддержать человека, позвать взрослого, переслать видео, присоединиться к насмешкам, сохранить доказательство безопасным способом и передать взрослому. Обсудите последствия.'],['Карточка ситуации',9,'Разберите карточку №1 или №2. Найдите безопасное действие, которое реально выполнить.'],['Фразы поддержки',7,'Потренируйте фразы: «Я вижу, что это неприятно. Пойдём вместе к взрослому»; «Я не буду это пересылать».'],['Итог',3,'Подчеркни: ответственность за остановку травли лежит на взрослых и школе, а не на ребёнке-свидетеле.']],cards:[['Ситуация 1. Чат','В общем чате публикуют унизительный мем про ученика. Несколько человек ставят смеющиеся реакции.','Почему пересылка усиливает вред? Что можно сделать вместо этого?'],['Ситуация 2. Перемена','Несколько учеников окружили одноклассника и не дают ему уйти. Ты это видишь из коридора.','Как привлечь дежурного взрослого? Почему не нужно физически вмешиваться одному?'],['Ситуация 3. После урока','Одноклассник сидит один и выглядит расстроенным после повторяющихся насмешек.','Как предложить поддержку без давления? Как помочь обратиться к взрослому?']],exercise:'В парах составьте два коротких сценария: поддержка пострадавшего без давления и сообщение взрослому без распространения слухов.',teacher:'Не возлагай на свидетелей обязанность самостоятельно прекращать опасное поведение. Не поощряй публичные конфронтации, угрозы или публикацию ответных материалов.'},
    {id:'digital',title:'Цифровая безопасность и травля в сети',topic:'Цифровая безопасность',ages:['6–10 лет','11–14 лет','15–18 лет'],goal:'Участники понимают, что онлайн-унижение тоже причиняет реальный вред, и знают базовые шаги защиты и обращения за помощью.',materials:'Карточки вымышленных онлайн-ситуаций, бумага.',steps:[['Безопасные правила',5,'Не показываем личные переписки и аккаунты класса. Не называем реальные имена и не воспроизводим оскорбительный контент.'],['Онлайн и офлайн',7,'Обсуди: сообщение, изображение или исключение из чата может причинять вред и после окончания уроков.'],['Что делать сначала',8,'Остановить пересылку, не отвечать угрозами, обратиться к взрослому. Если безопасно, сохранить ссылку/скриншот для передачи ответственному взрослому, не публикуя его.'],['Разбор карточек',10,'Разберите вымышленные ситуации и выберите безопасную последовательность действий.'],['Настройки и поддержка',7,'Обсуди блокировку и жалобу на платформе как дополнительные меры, а не замену помощи взрослого.'],['Завершение',3,'Каждый может назвать один способ прекратить распространение вреда и один канал помощи.']],cards:[['Ситуация 1. Пересылка','В чате распространяют изменённую фотографию ученика с унизительной подписью.','Что нельзя делать с этим материалом? Кому передать информацию?'],['Ситуация 2. Угрозы','В личных сообщениях подростку пишут угрозы и требуют прислать личные фотографии.','Почему важно немедленно обратиться к доверенному взрослому? Как сохранить сообщения, не пересылая их другим?'],['Ситуация 3. Исключение','Участников класса договорились исключить одного ученика из общего чата и высмеивать его в другом.','Как сообщить о ситуации взрослому? Почему это не «просто интернет»?']],exercise:'Составьте памятку из четырёх шагов: остановить распространение — не отвечать угрозами — сохранить нужные сведения безопасным способом — обратиться к взрослому.',teacher:'При угрозах, шантаже, сексуализированном вымогательстве, публикации интимных изображений или непосредственной опасности действуй незамедлительно по школьному алгоритму и требованиям закона. Не проси ребёнка пересылать интимные материалы.'},
    {id:'safe-climate',title:'Класс, в котором безопасно каждому',topic:'Безопасная среда',ages:['6–10 лет','11–14 лет','15–18 лет'],goal:'Класс формулирует конкретные правила уважительного общения и понятный способ реагирования на нарушение безопасности.',materials:'Стикеры или листы, доска.',steps:[['Старт',5,'Договорись: обсуждаем правила, а не конкретных учеников. Не используем личные истории и не называем имён.'],['Что такое безопасная среда',7,'Собери признаки: можно учиться без унижения, отказ уважают, взрослые реагируют, помощь доступна.'],['Разбор примеров',8,'Прочитайте карточки №1–3. Отделите несогласие и разовый спор от повторяющегося унижения и угроз. Любая угроза требует внимания взрослых.'],['Создание правил',10,'Сформулируйте 4–6 наблюдаемых правил: не унижать; не распространять чужие фото; уважать отказ; звать взрослого при угрозе; не поддерживать травлю реакциями и пересылками.'],['Что делают взрослые',7,'Назови школьные роли и реальные каналы обращения, которые подтверждены самой школой. Не придумывай контакты.'],['Итог',3,'Выберите одно правило, которое школа может поддерживать ежедневно.']],cards:[['Ситуация 1. Шутка','Ученик просит прекратить шутки о своей внешности, но они продолжаются.','Почему просьбу остановиться нужно уважать? Что может сделать взрослый?'],['Ситуация 2. Разногласие','Два ученика не согласны, как выполнять групповое задание. Они спорят, но не унижают друг друга.','Как договориться? Чем этот спор отличается от травли?'],['Ситуация 3. Повторяющееся исключение','Одного ученика систематически не берут в команды и публично высмеивают.','Какие признаки показывают, что нужна помощь взрослых? Как обеспечить безопасность?']],exercise:'Создайте короткий «план безопасного класса»: правило, как его заметить в повседневности, и что делает взрослый, если правило нарушено.',teacher:'Не проводи голосование о виновности и не организуй примирение сторон, если травля продолжается или есть неравенство сил. Сначала безопасность, индивидуальная оценка ситуации и действия взрослых.'}
  ];
  const $=id=>document.getElementById(id); const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let active=lessons[0]; let age='Все возраста';
  function renderList(){const q=($('searchLesson').value||'').trim().toLowerCase();const items=lessons.filter(x=>(age==='Все возраста'||x.ages.includes(age))&&(!q||(x.title+' '+x.topic+' '+x.goal).toLowerCase().includes(q)));$('lessonCards').innerHTML=items.map(x=>`<button class="lesson-card ${x.id===active.id?'selected':''}" type="button" data-id="${x.id}"><span class="kicker">${esc(x.topic)}</span><b>${esc(x.title)}</b><small>${esc(x.ages.join(' · '))}</small></button>`).join('')||'<p class="admin-muted">По этому запросу занятий не найдено.</p>';document.querySelectorAll('[data-id]').forEach(b=>b.addEventListener('click',()=>{active=lessons.find(x=>x.id===b.dataset.id);renderList();renderDetail();}));}
  function renderDetail(){const l=active;$('lessonDetail').innerHTML=`<article class="lesson-print"><span class="kicker">МЫ РЯДОМ · ГОТОВОЕ ЗАНЯТИЕ</span><h2>${esc(l.title)}</h2><p><b>Возраст:</b> ${esc(l.ages.join(', '))} · <b>Время:</b> 40 минут</p><h3>Цель</h3><p>${esc(l.goal)}</p><h3>Материалы</h3><p>${esc(l.materials)}</p><h3>Ход занятия</h3><ol>${l.steps.map(s=>`<li><b>${esc(s[0])} — ${s[1]} мин.</b><p>${esc(s[2])}</p></li>`).join('')}</ol><h3>Практическое задание</h3><p>${esc(l.exercise)}</p><h3>Рекомендации педагогу</h3><p>${esc(l.teacher)}</p><p class="source-note">Материал — методический шаблон для адаптации. До применения согласовать с педагогом-психологом и ответственным специалистом школы. При реальном сообщении о травле или угрозе действовать по утверждённому школьному порядку.</p></article><h3>Карточки ситуаций для печати</h3><div class="print-cards">${l.cards.map(c=>`<article class="situation-card"><b>${esc(c[0])}</b><p>${esc(c[1])}</p><i>Вопросы:</i><p>${esc(c[2])}</p></article>`).join('')}</div>`;}
  $('searchLesson').addEventListener('input',renderList);$('ageFilter').addEventListener('change',e=>{age=e.target.value;renderList();});$('printLessonPack').addEventListener('click',()=>{const w=window.open('','_blank');if(!w){$('printStatus').textContent='Разреши открытие окна печати.';return;}w.document.write(`<!doctype html><html lang="ru"><meta charset="utf-8"><title>${esc(active.title)}</title><style>body{font:15px/1.5 Arial,sans-serif;color:#172b4d;max-width:850px;margin:30px auto;padding:0 20px}h2{font-size:26px}h3{margin-top:24px}.situation-card{border:1.5px solid #657989;border-radius:12px;padding:16px;margin:12px 0;break-inside:avoid}.source-note{font-size:12px;color:#586c7a;border-top:1px solid #ddd;padding-top:12px}.print-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px}@media print{body{margin:12mm auto}.situation-card{break-inside:avoid}}</style><body>${$('lessonDetail').innerHTML}<script>window.onload=()=>window.print()<\/script></body></html>`);w.document.close();});
  renderList();renderDetail();
})();
